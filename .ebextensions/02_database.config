option_settings:
  aws:elasticbeanstalk:application:environment:
    AWS_REGION: "us-east-1"

    # Elastic Beanstalk connects directly to RDS; no SSH tunnel.
    USE_SSH_TUNNEL: "false"

    # The database is created once, outside the EB environment, so it survives
    # environment rebuilds and termination. The app reads DB_* first and falls
    # back to the RDS_* variables that EB's RDS integration injects.
    #
    # Set these as EB environment properties (eb setenv / Console >
    # Configuration > Environment properties), never in this file:
    #   DB_HOST, DB_NAME, DB_USER, DB_PASSWORD
    #   BUCKET_NAME, ADMIN_BOOTSTRAP_TOKEN
    #   SMTP_USER, SMTP_PASSWORD, APP_BASE_URL
