option_settings:
  aws:elasticbeanstalk:application:environment:
    # AWS/S3 Configuration
    AWS_REGION: "us-east-1"
    # BUCKET_NAME should be set in EB Environment Properties
    # ADMIN_BOOTSTRAP_TOKEN should be set in EB Environment Properties

    # Disable SSH tunnel on EB (use direct connection)
    USE_SSH_TUNNEL: "false"

    # NOTE: Do NOT set DB_HOST, DB_NAME, DB_USER, DB_PASSWORD here.
    # EB automatically provides these as environment variables when using aws:rds:dbinstance:
    # RDS_HOSTNAME, RDS_PORT, RDS_DB_NAME, RDS_USERNAME, RDS_PASSWORD
    # The application.py reads them with fallback logic.

  aws:rds:dbinstance:
    DBEngine: postgres
    DBEngineVersion: "16"
    DBInstanceClass: db.t3.micro
    DBAllocatedStorage: "20"
    DBDeletionPolicy: Snapshot
    MultiAZDatabase: false
    DBUser: "ebuser"
    DBPassword: ""
    DBName: "campus_marketplace"