# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BUCKET_NAME=

# Admin Bootstrap Token (for initial admin setup)
ADMIN_BOOTSTRAP_TOKEN=

# Database Configuration (for Elastic Beanstalk - direct connection)
# These will be set via EB Environment Properties or RDS integration
DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=

# SSH Tunnel Configuration (for LOCAL DEVELOPMENT only)
# Set USE_SSH_TUNNEL=false on Elastic Beanstalk
USE_SSH_TUNNEL=true
SSH_HOST=
SSH_USER=
SSH_KEY_PATH=
RDS_HOST=

# Optional: RDS Port (default 5432)
RDS_PORT=5432

# Password reset email (Gmail SMTP)
# APP_BASE_URL is the public URL of the EB environment, e.g.
#   http://ecamp-env.us-east-1.elasticbeanstalk.com
SMTP_USER=
SMTP_PASSWORD=
APP_BASE_URL=